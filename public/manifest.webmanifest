{
    "name": "Herdr Web",
    "short_name": "Herdr",
    "description": "View and drive your herdr coding agents from a phone",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#050607",
    "theme_color": "#050607",
    "icons": [
        {
            "src": "/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "scope": "/",
    "orientation": "any"
}
